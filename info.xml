<?xml version="1.0"?>
<extension key="com.joineryhq.hideactivitytypes" type="module">
  <file>hideactivitytypes</file>
  <name>Hide Activity Types</name>
  <description/>
  <license>AGPL-3.0</license>
  <maintainer>
    <author>Allen Shaw</author>
    <email>allen@joineryhq.com</email>
  </maintainer>
  <urls>
    <url desc="Main Extension Page">https://twomice.github.io/com.joineryhq.hideactivitytypes/</url>
    <url desc="Documentation">https://twomice.github.io/com.joineryhq.hideactivitytypes/</url>
    <url desc="Support">https://github.com/twomice/com.joineryhq.hideactivitytypes/issues</url>
    <url desc="Licensing">http://www.gnu.org/licenses/agpl-3.0.html</url>
  </urls>
  <releaseDate>2021-04-20</releaseDate>
  <version>1.0.3</version>
  <develStage>stable</develStage>
  <compatibility>
    <ver>5.51</ver>
  </compatibility>
  <comments>Developed by Allen Shaw (allen@joineryhq.com) and Eli Lisseck (lisseck@gmail.com) for Joinery and YEA.</comments>
  <classloader>
    <psr4 prefix="Civi\" path="Civi"/>
    <psr0 prefix="CRM_" path="."/>
  </classloader>
  <civix>
    <namespace>CRM/Hideactivitytypes</namespace>
    <format>25.10.2</format>
  </civix>
  <upgrader>CiviMix\Schema\Hideactivitytypes\AutomaticUpgrader</upgrader>
  <mixins>
    <mixin>smarty-v2@1.0.3</mixin>
    <mixin>entity-types-php@2.0.0</mixin>
    <mixin>scan-classes@1.0.0</mixin>
  </mixins>
</extension>
